{
    "name": "test-pro",
    "version": "1.0.0",
    "type": "module",
    "main": "dist/index.js",
    "license": "UNLICENSED",
    "scripts": {
        "start": "tsx watch --env-file-if-exists=.env.$ENV < /dev/null ./src/index.ts",
        "start:noreload": "tsx --env-file-if-exists=.env.$ENV < /dev/null ./src/index.ts",
        "start:dist": "NODE_ENV=production node --env-file-if-exists=.env.$ENV ./dist/index.js",
        "build": "rm -Rf dist && tsc && tsc-alias",
        "prettier": "prettier . --write --ignore-unknown",
        "format:check": "prettier . --check --ignore-unknown",
        "test": "vitest run",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "express": "^5.1.0",
        "zod": "^3.25.67"
    },
    "devDependencies": {
        "@trivago/prettier-plugin-sort-imports": "^5.2.2",
        "@types/express": "^5.0.6",
        "@types/node": "^24.0.3",
        "prettier": "^3.6.2",
        "tsc-alias": "^1.8.16",
        "tsx": "^4.20.3",
        "typescript": "^5.8.3",
        "vitest": "^4.1.12"
    }
}
